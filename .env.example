# Copy to .env.local for local development. Set real values in your host's secret manager.
# Never commit real values.

# Public origin of the site, used for canonical URLs, sitemap, RSS and social cards.
# Must be https in production, e.g. https://fishhawkbenches.example
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Contact form delivery through Resend (https://resend.com). Server-only.
RESEND_API_KEY=
# Inbox that receives messages.
CONTACT_TO_EMAIL=
# Sender on a domain verified in Resend, e.g. "FishHawk Benches <hello@your-domain>".
CONTACT_FROM_EMAIL=

# "resend" (default) or "log" to print a one-line summary instead of sending (local testing only;
# refused in production unless ALLOW_LOG_DELIVERY=true, which only the test suite sets).
CONTACT_DELIVERY=resend

# Optional: messages allowed per visitor per 15 minutes (default 5).
# CONTACT_RATE_LIMIT=5

# Optional, dev only: show draft benches in `npm run dev`. Ignored in production.
# SHOW_DRAFTS=true
