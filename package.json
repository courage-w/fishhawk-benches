{
  "name": "fishhawk-benches",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "ingest": "node scripts/ingest.ts",
    "validate": "node scripts/validate.ts",
    "typecheck": "next typegen && tsc --noEmit",
