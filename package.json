    "check": "npm run lint && npm run typecheck && npm run validate && npm run test && npm run build",
    "locate-views": "node scripts/locate-views.ts",
    "placeholders": "node scripts/placeholders.ts"
  },
  "dependencies": {
    "leaflet": "^1.9.4",
    "next": "16.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "server-only": "^0.0.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "exifr": "^7.1.3",
    "heic-convert": "^2.1.0",
